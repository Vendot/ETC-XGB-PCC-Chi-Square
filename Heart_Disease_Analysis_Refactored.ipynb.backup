   "source": [
    "# ===== UJI STATISTIK: FRIEDMAN TEST & NEMENYI POST-HOC =====\n",
    "print(\"=\" * 80)\n",
    "print(\"📊 UJI STATISTIK PERBANDINGAN 4 SKENARIO\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Install scikit-posthocs jika belum ada (uncomment jika perlu)\n",
    "# !pip install scikit-posthocs\n",
    "\n",
    "import scipy.stats as stats\n",
    "try:\n",
    "    import scikit_posthocs as sp\n",
    "    POSTHOC_AVAILABLE = True\n",
    "except ImportError:\n",
    "    print(\"⚠️  scikit-posthocs tidak terinstall. Install dengan: pip install scikit-posthocs\")\n",
    "    POSTHOC_AVAILABLE = False\n",
    "\n",
    "# Ambil konfigurasi terbaik per scenario (berdasarkan accuracy tertinggi)\n",
    "best_per_scenario = {}\n",
    "for scenario in ['Baseline', 'PCC', 'Chi2', 'Combined']:\n",
    "    df_scenario = df_cv_biasa[df_cv_biasa['Scenario'] == scenario]\n",
    "    best_idx = df_scenario['Accuracy_Mean'].idxmax()\n",
    "    best_per_scenario[scenario] = df_cv_biasa.loc[best_idx]\n",
    "\n",
    "print(\"\\n🎯 KONFIGURASI TERBAIK PER SCENARIO (UNTUK UJI STATISTIK):\")\n",
    "print(\"-\" * 80)\n",
    "best_configs = []\n",
    "for scenario, config in best_per_scenario.items():\n",
    "    best_configs.append({\n",
    "        'Scenario': scenario,\n",
    "        'Estimators': config['Estimators'],\n",
    "        'PCC_Threshold': config['PCC_Threshold'],\n",
    "        'Chi2_K': config['Chi2_K'],\n",
    "        'N_Features': config['N_Features'],\n",
    "        'Accuracy': config['Accuracy_Mean']\n",
    "    })\n",
    "df_best_configs = pd.DataFrame(best_configs)\n",
    "print(df_best_configs.to_string(index=False))\n",
    "\n",
    "# Kita perlu accuracy per-fold untuk setiap scenario terbaik\n",
    "# Karena kita hanya punya mean dan std, kita akan menggunakan mean accuracy dari semua konfigurasi per scenario\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"📈 ACCURACY DATA UNTUK FRIEDMAN TEST\")\n",
    "print(\"=\" * 80)\n",
    "print(\"Catatan: Menggunakan data accuracy dari semua konfigurasi per scenario\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "# Buat matrix untuk Friedman test (rows=konfigurasi, columns=scenarios)\n",
    "# Ambil semua konfigurasi yang ada untuk setiap scenario\n",
    "baseline_accuracies = df_cv_biasa[df_cv_biasa['Scenario'] == 'Baseline']['Accuracy_Mean'].values\n",
    "pcc_accuracies = df_cv_biasa[df_cv_biasa['Scenario'] == 'PCC']['Accuracy_Mean'].values\n",
    "chi2_accuracies = df_cv_biasa[df_cv_biasa['Scenario'] == 'Chi2']['Accuracy_Mean'].values\n",
    "combined_accuracies = df_cv_biasa[df_cv_biasa['Scenario'] == 'Combined']['Accuracy_Mean'].values\n",
    "\n",
    "# Tampilkan statistik deskriptif\n",
    "accuracy_summary = []\n",
    "for scenario, accs in [('Baseline', baseline_accuracies), \n",
    "                        ('PCC', pcc_accuracies), \n",
    "                        ('Chi2', chi2_accuracies), \n",
    "                        ('Combined', combined_accuracies)]:\n",
    "    accuracy_summary.append({\n",
    "        'Scenario': scenario,\n",
    "        'N_Config': len(accs),\n",
    "        'Mean': np.mean(accs),\n",
    "        'Std': np.std(accs),\n",
    "        'Min': np.min(accs),\n",
    "        'Max': np.max(accs),\n",
    "        'Median': np.median(accs)\n",
    "    })\n",
    "\n",
    "df_accuracy_summary = pd.DataFrame(accuracy_summary)\n",
    "print(\"\\n\" + df_accuracy_summary.to_string(index=False))\n",
    "\n",
    "# Friedman Test\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"🧪 FRIEDMAN TEST\")\n",
    "print(\"=\" * 80)\n",
    "print(\"H0: Tidak ada perbedaan signifikan antar 4 scenario\")\n",
    "print(\"H1: Ada perbedaan signifikan antar 4 scenario\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "# Pastikan semua array punya panjang yang sama (ambil minimum length)\n",
    "min_length = min(len(baseline_accuracies), len(pcc_accuracies), \n",
    "                 len(chi2_accuracies), len(combined_accuracies))\n",
    "\n",
    "baseline_accuracies = baseline_accuracies[:min_length]\n",
    "pcc_accuracies = pcc_accuracies[:min_length]\n",
    "chi2_accuracies = chi2_accuracies[:min_length]\n",
    "combined_accuracies = combined_accuracies[:min_length]\n",
    "\n",
    "# Lakukan Friedman test\n",
    "friedman_stat, friedman_p = stats.friedmanchisquare(\n",
    "    baseline_accuracies,\n",
    "    pcc_accuracies,\n",
    "    chi2_accuracies,\n",
    "    combined_accuracies\n",
    ")\n",
    "\n",
    "print(f\"Friedman Statistic: {friedman_stat:.4f}\")\n",
    "print(f\"P-value: {friedman_p:.6f}\")\n",
    "print(f\"Alpha level: 0.05\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "if friedman_p < 0.05:\n",
    "    print(\"✅ HASIL: Tolak H0 (p < 0.05)\")\n",
    "    print(\"   Ada perbedaan signifikan antar scenario!\")\n",
    "    print(\"   Lanjutkan dengan Nemenyi post-hoc test.\")\n",
    "else:\n",
    "    print(\"❌ HASIL: Gagal tolak H0 (p >= 0.05)\")\n",
    "    print(\"   Tidak ada perbedaan signifikan antar scenario.\")\n",
    "\n",
    "# Nemenyi Post-Hoc Test (jika Friedman signifikan)\n",
    "if friedman_p < 0.05 and POSTHOC_AVAILABLE:\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"🔬 NEMENYI POST-HOC TEST\")\n",
    "    print(\"=\" * 80)\n",
    "    print(\"Uji pairwise comparison untuk mengetahui pasangan scenario mana yang berbeda signifikan\")\n",
    "    print(\"-\" * 80)\n",
    "    \n",
    "    # Buat dataframe untuk Nemenyi test\n",
    "    accuracy_data = []\n",
    "    for i in range(min_length):\n",
    "        accuracy_data.append({'Baseline': baseline_accuracies[i], \n",
    "                             'PCC': pcc_accuracies[i],\n",
    "                             'Chi2': chi2_accuracies[i],\n",
    "                             'Combined': combined_accuracies[i]})\n",
    "    \n",
    "    df_accuracy_data = pd.DataFrame(accuracy_data)\n",
    "    \n",
    "    # Lakukan Nemenyi test\n",
    "    nemenyi_results = sp.posthoc_nemenyi_friedman(df_accuracy_data)\n",
    "    \n",
    "    print(\"\\nP-values Matrix (Nemenyi Test):\")\n",
    "    print(\"Nilai < 0.05 menunjukkan perbedaan signifikan\")\n",
    "    print(\"-\" * 80)\n",
    "    print(nemenyi_results.to_string())\n",
    "    \n",
    "    # Interpretasi hasil\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"📋 INTERPRETASI PAIRWISE COMPARISON:\")\n",
    "    print(\"=\" * 80)\n",
    "    \n",
    "    scenarios = ['Baseline', 'PCC', 'Chi2', 'Combined']\n",
    "    comparison_results = []\n",
    "    \n",
    "    for i, scen1 in enumerate(scenarios):\n",
    "        for j, scen2 in enumerate(scenarios):\n",
    "            if i < j:  # Hanya ambil upper triangle\n",
    "                p_val = nemenyi_results.loc[scen1, scen2]\n",
    "                is_sig = \"✅ Signifikan\" if p_val < 0.05 else \"❌ Tidak Signifikan\"\n",
    "                comparison_results.append({\n",
    "                    'Comparison': f'{scen1} vs {scen2}',\n",
    "                    'P-value': p_val,\n",
    "                    'Signifikan (α=0.05)': is_sig\n",
    "                })\n",
    "    \n",
    "    df_comparison = pd.DataFrame(comparison_results)\n",
    "    print(df_comparison.to_string(index=False))\n",
    "    \n",
    "elif friedman_p >= 0.05:\n",
    "    print(\"\\n⚠️  Nemenyi test tidak dilakukan karena Friedman test tidak signifikan.\")\n",
    "elif not POSTHOC_AVAILABLE:\n",
    "    print(\"\\n⚠️  Nemenyi test tidak dapat dilakukan karena scikit-posthocs tidak terinstall.\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)"
   ]
  },
