   "source": [
    "# ===== ANALISIS HASIL BERDASARKAN ACCURACY =====\n",
    "print(\"=\" * 80)\n",
    "print(\"📊 ANALISIS HASIL CROSS-VALIDATION BERDASARKAN ACCURACY\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Sort berdasarkan Accuracy_Mean\n",
    "df_cv_biasa_sorted = df_cv_biasa.sort_values('Accuracy_Mean', ascending=False)\n",
    "\n",
    "print(\"\\n🏆 TOP 10 KONFIGURASI BERDASARKAN ACCURACY:\")\n",
    "print(\"-\" * 80)\n",
    "top_10_cols = ['Scenario', 'Estimators', 'PCC_Threshold', 'Chi2_K', 'N_Features', 'Accuracy_Mean', 'Accuracy_Std']\n",
    "print(df_cv_biasa_sorted[top_10_cols].head(10).to_string(index=False))\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"📈 STATISTIK PER SCENARIO (ACCURACY)\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Statistik per scenario dalam bentuk tabel\n",
    "scenario_stats = []\n",
    "for scenario in ['Baseline', 'PCC', 'Chi2', 'Combined']:\n",
    "    df_scenario = df_cv_biasa[df_cv_biasa['Scenario'] == scenario]\n",
    "    scenario_stats.append({\n",
    "        'Scenario': scenario,\n",
    "        'Mean_Accuracy': df_scenario['Accuracy_Mean'].mean(),\n",
    "        'Std_Accuracy': df_scenario['Accuracy_Std'].mean(),\n",
    "        'Best_Accuracy': df_scenario['Accuracy_Mean'].max(),\n",
    "        'Worst_Accuracy': df_scenario['Accuracy_Mean'].min(),\n",
    "        'Mean_Features': df_scenario['N_Features'].mean()\n",
    "    })\n",
    "\n",
    "df_scenario_stats = pd.DataFrame(scenario_stats)\n",
    "print(df_scenario_stats.to_string(index=False))\n",
    "\n",
    "# Temukan konfigurasi terbaik\n",
    "best_config = df_cv_biasa_sorted.iloc[0]\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"🎯 KONFIGURASI TERBAIK (BERDASARKAN ACCURACY):\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"Scenario       : {best_config['Scenario']}\")\n",
    "print(f\"Estimators     : {best_config['Estimators']}\")\n",
