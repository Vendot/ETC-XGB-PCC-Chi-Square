    "            ha='center', va='bottom', fontsize=11, fontweight='bold')\n",
    "\n",
    "ax1.set_title('Distribusi Kelas', fontsize=12, fontweight='bold')\n",
    "ax1.set_ylabel('Jumlah', fontsize=10)\n",
    "ax1.grid(True, alpha=0.3, axis='y', linestyle='--')\n",
    "\n",
