    "# Statistik target\n",
    "print(f\"\\nDistribusi Target:\")\n",
    "print(f\"  • Tidak Sakit (0): {target_counts[0]} sampel ({target_counts[0]/len(df_original)*100:.2f}%)\")\n",
    "print(f\"  • Sakit (1): {target_counts[1]} sampel ({target_counts[1]/len(df_original)*100:.2f}%)\")\n"
