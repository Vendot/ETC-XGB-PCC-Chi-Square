   "source": [
    "# ===== GRID SEARCH DENGAN STRATIFIED CV =====\n",
    "print(\"🔍 Memulai Grid Search dengan Stratified Cross-Validation...\")\n",
    "\n",
    "# Hitung total kombinasi\n",
    "total_kombinasi = (\n",
    "    len(ESTIMATORS_LIST) +  # Baseline: hanya estimators\n",
    "    len(PCC_THRESHOLD_LIST) * len(ESTIMATORS_LIST) +  # PCC: PCC_Threshold × estimators\n",
    "    len(CHI2_K_LIST) * len(ESTIMATORS_LIST) +  # Chi2: Chi2_K × estimators\n",
    "    len(PCC_THRESHOLD_LIST) * len(CHI2_K_LIST) * len(ESTIMATORS_LIST)  # Combined: keduanya\n",
    ")\n",
    "\n",
    "print(f\"Total kombinasi parameter:\")\n",
    "print(f\"  • Baseline : {len(ESTIMATORS_LIST)} kombinasi\")\n",
    "print(f\"  • PCC      : {len(PCC_THRESHOLD_LIST)} × {len(ESTIMATORS_LIST)} = {len(PCC_THRESHOLD_LIST) * len(ESTIMATORS_LIST)} kombinasi\")\n",
    "print(f\"  • Chi2     : {len(CHI2_K_LIST)} × {len(ESTIMATORS_LIST)} = {len(CHI2_K_LIST) * len(ESTIMATORS_LIST)} kombinasi\")\n",
    "print(f\"  • Combined : {len(PCC_THRESHOLD_LIST)} × {len(CHI2_K_LIST)} × {len(ESTIMATORS_LIST)} = {len(PCC_THRESHOLD_LIST) * len(CHI2_K_LIST) * len(ESTIMATORS_LIST)} kombinasi\")\n",
    "print(f\"  • TOTAL    : {total_kombinasi} kombinasi\")\n",
    "print(f\"Jumlah fold per kombinasi: 5\")\n",
    "print(f\"Total evaluasi model: {total_kombinasi * 5}\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "waktu_mulai = time.time()\n",
    "\n",
    "hasil_cv_biasa = []\n",
    "\n",
    "# 1. BASELINE - Hanya variasi estimators\n",
    "print(\"\\n📍 BASELINE SCENARIO\")\n",
    "baseline_results = []\n",
    "for estimators in ESTIMATORS_LIST:\n",
    "    hasil = evaluasi_stratified_cv(\n",
    "        X_train_final, \n",
    "        y_train_final,\n",
    "        pcc_thresh=0.0,  # Tidak digunakan\n",
    "        chi2_k=1,  # Tidak digunakan\n",
    "        estimators=estimators,\n",
    "        n_folds=5,\n",
    "        random_state=RANDOM_STATE\n",
    "    )\n",
    "    \n",
    "    hasil_cv_biasa.append({\n",
    "        'Scenario': 'Baseline',\n",
    "        'Estimators': estimators,\n",
    "        'PCC_Threshold': None,\n",
    "        'Chi2_K': None,\n",
    "        'N_Features': hasil['Baseline']['n_features'],\n",
    "        'Accuracy_Mean': hasil['Baseline']['accuracy_mean'],\n",
    "        'Accuracy_Std': hasil['Baseline']['accuracy_std'],\n",
    "        'Precision_Mean': hasil['Baseline']['precision_mean'],\n",
    "        'Precision_Std': hasil['Baseline']['precision_std'],\n",
    "        'Recall_Mean': hasil['Baseline']['recall_mean'],\n",
    "        'Recall_Std': hasil['Baseline']['recall_std'],\n",
    "        'F1_Mean': hasil['Baseline']['f1_mean'],\n",
    "        'F1_Std': hasil['Baseline']['f1_std']\n",
    "    })\n",
    "    \n",
    "    baseline_results.append({\n",
    "        'Estimators': estimators,\n",
    "        'N_Features': hasil['Baseline']['n_features'],\n",
    "        'F1_Mean': hasil['Baseline']['f1_mean'],\n",
    "        'F1_Std': hasil['Baseline']['f1_std']\n",
    "    })\n",
    "\n",
    "df_baseline = pd.DataFrame(baseline_results)\n",
    "print(df_baseline.to_string(index=False))\n",
    "\n",
    "# 2. PCC SCENARIO - Variasi PCC_Threshold dan estimators\n",
    "print(\"\\n📍 PCC SCENARIO\")\n",
    "pcc_results = []\n",
    "for pcc_thresh in PCC_THRESHOLD_LIST:\n",
    "    for estimators in ESTIMATORS_LIST:\n",
    "        hasil = evaluasi_stratified_cv(\n",
    "            X_train_final, \n",
    "            y_train_final,\n",
    "            pcc_thresh=pcc_thresh,\n",
    "            chi2_k=1,  # Tidak digunakan\n",
    "            estimators=estimators,\n",
    "            n_folds=5,\n",
    "            random_state=RANDOM_STATE\n",
    "        )\n",
    "        \n",
    "        hasil_cv_biasa.append({\n",
    "            'Scenario': 'PCC',\n",
    "            'Estimators': estimators,\n",
    "            'PCC_Threshold': pcc_thresh,\n",
    "            'Chi2_K': None,\n",
    "            'N_Features': hasil['PCC']['n_features'],\n",
    "            'Accuracy_Mean': hasil['PCC']['accuracy_mean'],\n",
    "            'Accuracy_Std': hasil['PCC']['accuracy_std'],\n",
    "            'Precision_Mean': hasil['PCC']['precision_mean'],\n",
    "            'Precision_Std': hasil['PCC']['precision_std'],\n",
    "            'Recall_Mean': hasil['PCC']['recall_mean'],\n",
    "            'Recall_Std': hasil['PCC']['recall_std'],\n",
    "            'F1_Mean': hasil['PCC']['f1_mean'],\n",
    "            'F1_Std': hasil['PCC']['f1_std']\n",
    "        })\n",
    "        \n",
    "        pcc_results.append({\n",
    "            'PCC_Threshold': pcc_thresh,\n",
    "            'Estimators': estimators,\n",
    "            'N_Features': hasil['PCC']['n_features'],\n",
    "            'F1_Mean': hasil['PCC']['f1_mean'],\n",
    "            'F1_Std': hasil['PCC']['f1_std']\n",
    "        })\n",
    "\n",
    "df_pcc = pd.DataFrame(pcc_results)\n",
    "print(df_pcc.to_string(index=False))\n",
    "\n",
    "# 3. CHI2 SCENARIO - Variasi Chi2_K dan estimators\n",
    "print(\"\\n📍 CHI2 SCENARIO\")\n",
    "chi2_results = []\n",
    "for chi2_k in CHI2_K_LIST:\n",
    "    for estimators in ESTIMATORS_LIST:\n",
    "        hasil = evaluasi_stratified_cv(\n",
    "            X_train_final, \n",
    "            y_train_final,\n",
    "            pcc_thresh=0.0,  # Tidak digunakan\n",
    "            chi2_k=chi2_k,\n",
    "            estimators=estimators,\n",
    "            n_folds=5,\n",
    "            random_state=RANDOM_STATE\n",
    "        )\n",
    "        \n",
    "        hasil_cv_biasa.append({\n",
    "            'Scenario': 'Chi2',\n",
    "            'Estimators': estimators,\n",
    "            'PCC_Threshold': None,\n",
    "            'Chi2_K': chi2_k,\n",
    "            'N_Features': hasil['Chi2']['n_features'],\n",
    "            'Accuracy_Mean': hasil['Chi2']['accuracy_mean'],\n",
    "            'Accuracy_Std': hasil['Chi2']['accuracy_std'],\n",
    "            'Precision_Mean': hasil['Chi2']['precision_mean'],\n",
    "            'Precision_Std': hasil['Chi2']['precision_std'],\n",
    "            'Recall_Mean': hasil['Chi2']['recall_mean'],\n",
    "            'Recall_Std': hasil['Chi2']['recall_std'],\n",
    "            'F1_Mean': hasil['Chi2']['f1_mean'],\n",
    "            'F1_Std': hasil['Chi2']['f1_std']\n",
    "        })\n",
    "        \n",
    "        chi2_results.append({\n",
    "            'Chi2_K': chi2_k,\n",
    "            'Estimators': estimators,\n",
    "            'N_Features': hasil['Chi2']['n_features'],\n",
    "            'F1_Mean': hasil['Chi2']['f1_mean'],\n",
    "            'F1_Std': hasil['Chi2']['f1_std']\n",
    "        })\n",
    "\n",
    "df_chi2 = pd.DataFrame(chi2_results)\n",
    "print(df_chi2.to_string(index=False))\n",
    "\n",
    "# 4. COMBINED SCENARIO - Variasi PCC_Threshold, Chi2_K, dan estimators\n",
    "print(\"\\n📍 COMBINED SCENARIO\")\n",
    "combined_results = []\n",
    "for pcc_thresh in PCC_THRESHOLD_LIST:\n",
    "    for chi2_k in CHI2_K_LIST:\n",
    "        for estimators in ESTIMATORS_LIST:\n",
    "            hasil = evaluasi_stratified_cv(\n",
    "                X_train_final, \n",
    "                y_train_final,\n",
    "                pcc_thresh=pcc_thresh,\n",
    "                chi2_k=chi2_k,\n",
    "                estimators=estimators,\n",
    "                n_folds=5,\n",
    "                random_state=RANDOM_STATE\n",
    "            )\n",
    "            \n",
    "            hasil_cv_biasa.append({\n",
    "                'Scenario': 'Combined',\n",
    "                'Estimators': estimators,\n",
    "                'PCC_Threshold': pcc_thresh,\n",
    "                'Chi2_K': chi2_k,\n",
    "                'N_Features': hasil['Combined']['n_features'],\n",
    "                'Accuracy_Mean': hasil['Combined']['accuracy_mean'],\n",
    "                'Accuracy_Std': hasil['Combined']['accuracy_std'],\n",
    "                'Precision_Mean': hasil['Combined']['precision_mean'],\n",
    "                'Precision_Std': hasil['Combined']['precision_std'],\n",
    "                'Recall_Mean': hasil['Combined']['recall_mean'],\n",
    "                'Recall_Std': hasil['Combined']['recall_std'],\n",
    "                'F1_Mean': hasil['Combined']['f1_mean'],\n",
    "                'F1_Std': hasil['Combined']['f1_std']\n",
    "            })\n",
    "            \n",
    "            combined_results.append({\n",
    "                'PCC_Threshold': pcc_thresh,\n",
    "                'Chi2_K': chi2_k,\n",
    "                'Estimators': estimators,\n",
    "                'N_Features': hasil['Combined']['n_features'],\n",
    "                'F1_Mean': hasil['Combined']['f1_mean'],\n",
    "                'F1_Std': hasil['Combined']['f1_std']\n",
    "            })\n",
    "\n",
    "df_combined = pd.DataFrame(combined_results)\n",
    "print(df_combined.to_string(index=False))\n",
    "\n",
    "waktu_selesai = time.time()\n",
    "waktu_total = waktu_selesai - waktu_mulai\n",
    "\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(f\"✅ Grid Search Selesai!\")\n",
    "print(f\"⏱️ Waktu eksekusi: {waktu_total:.2f} detik\")\n",
    "print(f\"📊 Total hasil: {len(hasil_cv_biasa)} kombinasi\")\n",
    "\n",
    "# Konversi ke DataFrame\n",
    "df_cv_biasa = pd.DataFrame(hasil_cv_biasa)\n",
    "print(\"\\n📋 Preview hasil:\")\n",
    "print(df_cv_biasa.head(10))"
   ]
  },
