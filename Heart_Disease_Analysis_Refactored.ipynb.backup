      "  4. restecg      - Unique: 3, Values: [np.float64(0.0), np.float64(1.0), np.float64(2.0)]\n",
      "  5. exang        - Unique: 2, Values: [np.float64(0.0), np.float64(1.0)]\n",
      "  6. slope        - Unique: 3, Values: [np.float64(0.0), np.float64(1.0), np.float64(2.0)]\n",
