    "# ===== TAMPILKAN DETAIL HASIL CV DALAM BENTUK TABEL =====\n",
    "print(\"=\" * 80)\n",
    "print(\"📋 DETAIL HASIL CROSS-VALIDATION (TRAIN & TEST DARI 5-FOLD CV)\")\n",
    "print(\"=\" * 80)\n",
    "print(\"Catatan: Dalam Stratified CV, setiap fold menggunakan 4/5 data untuk training\")\n",
    "print(\"         dan 1/5 data untuk testing (validasi). Hasil test di sini adalah\")\n",
    "print(\"         hasil validasi pada fold test set.\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Tampilkan hasil lengkap dengan semua metrik\n",
    "print(\"\\n📊 SEMUA KONFIGURASI DAN HASIL CV:\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "# Pilih kolom yang akan ditampilkan\n",
    "display_cols = [\n",
    "    'Scenario', 'Estimators', 'PCC_Threshold', 'Chi2_K', 'N_Features',\n",
    "    'Accuracy_Mean', 'Accuracy_Std', \n",
    "    'Precision_Mean', 'Precision_Std',\n",
    "    'Recall_Mean', 'Recall_Std',\n",
    "    'F1_Mean', 'F1_Std'\n",
    "]\n",
    "\n",
    "# Tampilkan semua hasil dalam bentuk tabel\n",
    "print(df_cv_biasa[display_cols].to_string(index=False))\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"📈 SUMMARY STATISTIK:\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Total konfigurasi: {len(df_cv_biasa)}\")\n",
    "print(f\"Skenario yang diuji: {df_cv_biasa['Scenario'].nunique()}\")\n",
    "print(f\"Range Accuracy: {df_cv_biasa['Accuracy_Mean'].min():.4f} - {df_cv_biasa['Accuracy_Mean'].max():.4f}\")\n",
    "print(f\"Range F1 Score: {df_cv_biasa['F1_Mean'].min():.4f} - {df_cv_biasa['F1_Mean'].max():.4f}\")\n",
    "\n",
    "# Tampilkan top 5 konfigurasi berdasarkan Accuracy\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"🏆 TOP 5 KONFIGURASI BERDASARKAN ACCURACY:\")\n",
    "print(\"-\" * 80)\n",
    "top_5 = df_cv_biasa.nlargest(5, 'Accuracy_Mean')\n",
    "print(top_5[display_cols].to_string(index=False))"
