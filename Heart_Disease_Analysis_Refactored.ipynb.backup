   "source": [
    "# # ===== CEK KORELASI FITUR NUMERIK DENGAN TARGET =====\n",
    "# print(\"=\" * 80)\n",
    "# print(\"🔍 VERIFIKASI: Korelasi Fitur Numerik dengan Target\")\n",
    "# print(\"=\" * 80)\n",
    "\n",
    "# # Hitung korelasi absolut setiap fitur numerik dengan target\n",
    "# X_numerik = X_train_final[FITUR_KONTINYU]\n",
    "# pcc_scores = {}\n",
    "# for col in X_numerik.columns:\n",
    "#     corr = X_numerik[col].corr(y_train_final)\n",
    "#     pcc_scores[col] = abs(corr)\n",
    "\n",
    "# # Tampilkan hasil\n",
    "# print(\"\\n📊 Korelasi Absolut Fitur Numerik dengan Target:\")\n",
    "# print(\"-\" * 80)\n",
    "# for fitur, score in sorted(pcc_scores.items(), key=lambda x: x[1], reverse=True):\n",
    "#     print(f\"  {fitur:12} : {score:.4f}\")\n",
    "\n",
    "# print(\"\\n\" + \"=\" * 80)\n",
    "# print(\"✅ Fitur yang Terseleksi dengan Berbagai Threshold:\")\n",
