    "print(f\"  2. PCC Scenario: {total_pcc:>4} kombinasi\")\n",
    "print(f\"  3. Chi2 Scenario: {total_chi2:>4} kombinasi\")\n",
    "print(f\"  4. Combined: {total_combined:>4} kombinasi\")\n",
