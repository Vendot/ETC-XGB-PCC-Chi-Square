    "\n",
    "print(\"\\n📊 Parameter Feature Selection:\")\n",
    "print(f\"  • PCC Threshold: {PCC_THRESHOLD_LIST} ({len(PCC_THRESHOLD_LIST)} nilai)\")\n",
    "print(f\"  • Chi2 K: {CHI2_K_LIST} ({len(CHI2_K_LIST)} nilai)\")\n",
