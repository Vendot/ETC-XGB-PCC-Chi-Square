   "source": [
    "# Kategorisasi fitur berdasarkan tipe\n",
    "FITUR_KONTINYU = ['age', 'trestbps', 'chol', 'thalach', 'oldpeak']\n",
    "FITUR_kategorikal = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\n",
