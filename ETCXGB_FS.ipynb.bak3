   "source": [
    "# 📊 VISUAL CONFUSION MATRICES - BEST FROM EACH SCENARIO TYPE\n",
    "print(\"📊 VISUAL CONFUSION MATRICES - BEST FROM EACH SCENARIO TYPE\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# Get best result from each unique scenario type\n",
    "unique_scenarios = results_df['Scenario'].unique()\n",
    "best_results = []\n",
    "\n",
    "for scenario in unique_scenarios:\n",
    "    scenario_data = results_df[results_df['Scenario'] == scenario]\n",
    "    best_idx = scenario_data['F1_Mean'].idxmax()\n",
    "    best_results.append(scenario_data.loc[best_idx])\n",
    "\n",
    "# Create visualization for confusion matrices\n",
    "n_scenarios = len(best_results)\n",
    "cols = 2\n",
    "rows = (n_scenarios + 1) // 2\n",
    "\n",
    "fig, axes = plt.subplots(rows, cols, figsize=(12, rows*5))\n",
    "param_config_suffix = f\"[S1:{ETC_STAGE1_ESTIMATORS_LIST}|S2:{ETC_STAGE2_ESTIMATORS_LIST}|RS:{RANDOM_STATE_LIST}|PCC:{PCC_THRESHOLD_LIST}|Chi2:{CHI2_K_LIST}]\"\n",
    "fig.suptitle(f'Best Confusion Matrices for Each Scenario\\n{param_config_suffix}', fontsize=14, fontweight='bold')\n",
    "\n",
    "if rows == 1:\n",
    "    axes = [axes] if cols == 1 else axes\n",
    "else:\n",
    "    axes = axes.ravel()\n",
    "\n",
    "for i, row in enumerate(best_results):\n",
    "    if i >= len(axes):\n",
    "        break\n",
    "        \n",
    "    cm = row['Confusion_Matrix']\n",
    "    \n",
    "    # Create heatmap\n",
    "    im = axes[i].imshow(cm, interpolation='nearest', cmap='Blues')\n",
    "    param_str = f\"S1:{row['Stage1_Estimators']}|S2:{row['Stage2_Estimators']}|RS:{row['Random_State']}|PCC:{row['PCC_Threshold']}|Chi2:{row['Chi2_K']}\"\n",
    "    axes[i].set_title(f\"{row['Scenario']}\\nF1: {row['F1_Mean']:.4f}±{row['F1_Std']:.3f}\\n{param_str}\", \n",
    "                     fontsize=10, fontweight='bold')\n",
    "    \n",
    "    # Add text annotations\n",
    "    thresh = cm.max() / 2.\n",
    "    for j in range(2):\n",
    "        for k in range(2):\n",
    "            axes[i].text(k, j, format(cm[j, k], 'd'),\n",
    "                        ha=\"center\", va=\"center\",\n",
    "                        color=\"white\" if cm[j, k] > thresh else \"black\",\n",
    "                        fontsize=14, fontweight='bold')\n",
    "    \n",
    "    # Set labels\n",
    "    axes[i].set_ylabel('Actual', fontsize=10)\n",
    "    axes[i].set_xlabel('Predicted', fontsize=10)\n",
    "    axes[i].set_xticks([0, 1])\n",
    "    axes[i].set_yticks([0, 1])\n",
    "    axes[i].set_xticklabels(['No Disease (0)', 'Disease (1)'], fontsize=9)\n",
    "    axes[i].set_yticklabels(['No Disease (0)', 'Disease (1)'], fontsize=9)\n",
    "    \n",
    "    # Add colorbar\n",
    "    plt.colorbar(im, ax=axes[i], shrink=0.8)\n",
    "\n",
    "# Hide unused subplots\n",
    "for i in range(len(best_results), len(axes)):\n",
    "    axes[i].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 📈 METRICS COMPARISON VISUALIZATION - BEST FROM EACH SCENARIO\n",
    "print(f\"\\n📈 DETAILED METRICS COMPARISON - BEST FROM EACH SCENARIO\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# Create metrics comparison visualization using best results from each scenario\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 10))\n",
    "fig.suptitle(f'Performance Metrics Comparison - Best from Each Scenario\\n{param_config_suffix}', fontsize=14, fontweight='bold')\n",
    "\n",
    "metrics = ['Accuracy', 'Precision', 'Recall', 'Specificity', 'F1']\n",
    "metric_cols = ['Accuracy_Mean', 'Precision_Mean', 'Recall_Mean', 'Specificity_Mean', 'F1_Mean']\n",
    "metric_std_cols = ['Accuracy_Std', 'Precision_Std', 'Recall_Std', 'Specificity_Std', 'F1_Std']\n",
    "\n",
    "best_results_df = pd.DataFrame(best_results)\n",
    "colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4'][:len(best_results)]\n",
    "\n",
    "for i, (metric, mean_col, std_col) in enumerate(zip(metrics, metric_cols, metric_std_cols)):\n",
    "    row, col = divmod(i, 3)\n",
    "    ax = axes[row, col]\n",
    "    \n",
    "    mean_vals = best_results_df[mean_col]\n",
    "    std_vals = best_results_df[std_col]\n",
    "    scenario_names = [s.replace('_Scenario', '').replace('_', ' ') for s in best_results_df['Scenario']]\n",
    "    \n",
    "    bars = ax.bar(range(len(best_results_df)), mean_vals, yerr=std_vals, \n",
    "                  capsize=5, alpha=0.8, color=colors)\n",
    "    \n",
    "    ax.set_title(f'{metric} Comparison', fontsize=12, fontweight='bold')\n",
    "    ax.set_ylabel(metric, fontsize=10)\n",
    "    ax.set_xticks(range(len(best_results_df)))\n",
    "    ax.set_xticklabels(scenario_names, rotation=45, ha='right', fontsize=9)\n",
    "    ax.grid(axis='y', alpha=0.3)\n",
    "    \n",
    "    # Add value labels on bars\n",
    "    for bar, mean, std in zip(bars, mean_vals, std_vals):\n",
    "        ax.text(bar.get_x() + bar.get_width()/2, mean + std + 0.01, \n",
    "                f'{mean:.3f}', ha='center', fontsize=9, fontweight='bold')\n",
    "\n",
    "# Remove empty subplot\n",
    "axes[1, 2].remove()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"✅ Visual analysis completed\")"
   ]
  },
